{
  "name": "lamma-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "vite --mode api",
    "build": "tsc --noEmit && vite build",
    "build:api": "tsc --noEmit && vite build --mode api",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "check:engine": "tsx scripts/engine-check.ts",
    "build:artifact": "vite build --mode single && python3 scripts/build-artifact.py"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
