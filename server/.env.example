# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://lamma:lamma@localhost:5432/lamma_dev

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://tvabaaly-arch.github.io

# Public URL of this API (used to build image URLs for uploads and product photos).
PUBLIC_API_URL=http://localhost:8787

# Providers — only the built-in development providers exist for now.
# SMS: "console" prints OTP codes to the server log (no SMS is sent).
SMS_PROVIDER=console
# Fixed OTP for local development and tests ONLY. Leave empty in production.
OTP_DEV_CODE=1234
# Payments: "demo" marks orders paid without charging anything.
PAYMENT_PROVIDER=demo

UPLOAD_DIR=./uploads
